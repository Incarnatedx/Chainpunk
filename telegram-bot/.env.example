# Get the token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=put-your-bot-token-here
# A free Ethereum mainnet RPC URL (Alchemy or Infura work)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
# 1 shows the holder's shortened address on the card, 0 hides it
SHOW_HOLDER=1
# cairosvg (default) or browser (needs playwright; use if the punk glyphs look wrong)
RENDERER=cairosvg
# Optional: concurrent requests for the one-time artwork index (1-4; lower if rate-limited)
INDEX_WORKERS=2
